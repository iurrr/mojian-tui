{
  "name": "mojian-tui",
  "version": "1.0.0",
  "description": "A dependency-free terminal writing app with a TUI interface.",
  "private": true,
  "type": "module",
  "bin": {
    "mojian": "./src/main.ts"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "check": "node --check src/main.ts",
    "test": "node test/writer_tui.test.ts",
    "ci": "npm run check && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "tui",
    "writing",
    "editor",
    "terminal",
    "chinese"
  ],
  "license": "MIT"
}
