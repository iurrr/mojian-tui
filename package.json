{
  "name": "mojian-tui",
  "version": "1.0.0",
  "description": "A dependency-free terminal writing app with a TUI interface.",
  "type": "module",
  "bin": {
    "mojian": "dist/cli.js"
  },
  "files": [
    "dist/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node src/main.ts",
    "check": "node --check src/main.ts",
    "test": "node test/writer_tui.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run ci",
    "ci": "npm run check && npm test && npm run build && node --check dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iurrr/mojian-tui.git"
  },
  "bugs": {
    "url": "https://github.com/iurrr/mojian-tui/issues"
  },
  "homepage": "https://github.com/iurrr/mojian-tui#readme",
  "keywords": [
    "tui",
    "writing",
    "editor",
    "terminal",
    "chinese"
  ],
  "license": "MIT"
}
